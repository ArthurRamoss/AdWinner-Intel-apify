# AdWinner Intel - Apify Actor Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Apify API token (for running ad library scraper actors)
# Get it from: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# OPTIONAL: dedicated token for the FB/TikTok scraper Actor calls. Set this to
# bill scraping to a specific account, independent of where this Actor is
# deployed. If unset, falls back to APIFY_TOKEN.
SCRAPER_APIFY_TOKEN=

# Google Gemini API key for AI creative analysis (video/image)
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# OPTIONAL
# =============================================================================

# Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Redis connection URL for caching (reduces API calls and cost)
# Leave empty to run without cache
REDIS_URL=

# =============================================================================
# OPTIONAL: Appwrite Storage (for TikTok video analysis + persistent cache)
# =============================================================================

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=
APPWRITE_DATABASE_ID=adwinner
APPWRITE_FRESHNESS_HOURS=48
APPWRITE_SIGNED_URLS=true
APPWRITE_SIGNED_URL_TTL_SECONDS=3600
